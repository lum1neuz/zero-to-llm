{
  "name": "zero-to-llm",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Zero to LLM: build, shrink, adapt and serve a language model, one runnable lesson at a time. An interactive course from micrograd to quantization, fine-tuning for a new language and serving.",
  "scripts": {
    "content": "node pipeline/cli.ts build && node scripts/copy-pyodide.ts",
    "validate": "node pipeline/cli.ts validate",
    "check:challenges": "node pipeline/check-challenges.ts",
    "test": "node --test \"pipeline/test/*.test.ts\"",
    "dev": "npm run content && astro dev",
    "build": "npm run content && astro build && node scripts/sw-manifest.ts",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "astro": "7.3.5",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "wrangler": "4.145.0"
  }
}

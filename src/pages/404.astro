---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <div class="shell">
    <header class="appbar"><div class="appbar-in"><a class="brand" href="/"><b>Zero to LLM</b></a></div></header>
    <main class="page">
      <div class="eyebrow-s">404</div>
      <h1 class="page-title" style="margin:4px 0 12px">This page isn't on the path</h1>
      <p class="fine" style="font-size:15px">The link may be old, or the lesson id may be mistyped. Lesson pages look like <code>/learn/3.1/</code>, <code>/build/3.1/</code> and <code>/read/3.1/</code>.</p>
      <p style="margin-top:16px"><a class="btn primary" href="/">Back to your path</a></p>
    </main>
  </div>
</Base>

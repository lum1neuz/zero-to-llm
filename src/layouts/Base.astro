---
import "../styles/global.css";
interface Props { title: string; description?: string }
const { title, description = "Zero to LLM: build, shrink, adapt and serve a language model, one runnable lesson at a time." } = Astro.props;
const prod = import.meta.env.PROD;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Zero to LLM</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1C5AB6" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=JetBrains+Mono:wght@400;600&family=Noto+Sans:wght@400;700&display=swap" />
    <script is:inline>
      try {
        const t = localStorage.getItem("z2l.theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {prod && (
      <script is:inline>
        if ("serviceWorker" in navigator) addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
      </script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
